# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# LINE OAuth - Login ครั้งเดียวจบ (ทำครั้งเดียวสำหรับทั้งระบบ)
# จาก https://developers.line.biz/console/
# - สร้าง LINE Login channel → เอา Channel ID + Secret
LINE_LOGIN_CHANNEL_ID=1234567890
LINE_LOGIN_CHANNEL_SECRET=abcdef1234567890abcdef1234567890

# LINE Messaging API (OA กลางของระบบ)
# จาก https://developers.line.biz/console/
# - สร้าง Messaging API channel → เอา Channel Access Token
LINE_MESSAGING_CHANNEL_TOKEN=YOUR_LONG_LIVED_CHANNEL_ACCESS_TOKEN_HERE
