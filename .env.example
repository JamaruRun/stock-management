# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# LINE OAuth - Login ครั้งเดียวจบ (ทำครั้งเดียวสำหรับทั้งระบบ)
# จาก https://developers.line.biz/console/
# - สร้าง LINE Login channel → เอา Channel ID + Secret
LINE_LOGIN_CHANNEL_ID=1234567890
LINE_LOGIN_CHANNEL_SECRET=abcdef1234567890abcdef1234567890

# LINE Messaging API (OA กลางของระบบ)
# จาก https://developers.line.biz/console/ หน้า Messaging API channel เดียวกัน
# - Channel Access Token (long-lived) → LINE_MESSAGING_CHANNEL_TOKEN
# - Channel secret (Basic settings) → LINE_MESSAGING_CHANNEL_SECRET (ใช้ตรวจ signature ของ webhook กันคนยิง event ปลอมเข้ามา)
LINE_MESSAGING_CHANNEL_TOKEN=YOUR_LONG_LIVED_CHANNEL_ACCESS_TOKEN_HERE
LINE_MESSAGING_CHANNEL_SECRET=YOUR_MESSAGING_API_CHANNEL_SECRET_HERE

# Gemini API (ฟรี) - ใช้แปลคำถามที่ทัก LINE/Messenger ถามข้อมูลร้าน (รายรับ-รายจ่าย/สต๊อก/จำนำ) เป็น intent + พารามิเตอร์
# สมัคร/สร้างคีย์ได้ที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Facebook Messenger - ให้ถามข้อมูลร้านผ่าน Messenger ได้เหมือน LINE (ดูวิธีตั้งค่าใน MESSENGER_SETUP.md)
# Page Access Token (จากหน้า Messenger product ของ Facebook App)
MESSENGER_PAGE_ACCESS_TOKEN=YOUR_PAGE_ACCESS_TOKEN_HERE
# App Secret (Basic settings ของ Facebook App) - ใช้ตรวจ signature ของ webhook
MESSENGER_APP_SECRET=YOUR_APP_SECRET_HERE
# ตั้งเองเป็น string สุ่มอะไรก็ได้ ใช้ตอน verify webhook URL ตอน subscribe
MESSENGER_VERIFY_TOKEN=ตั้งค่าอะไรก็ได้ที่สุ่มและยาว

# Cron auth - ป้องกันคนนอกยิง /api/cron/* เอง ตั้งค่าเดียวกันใน Vercel project env vars
# Vercel จะแนบ Authorization: Bearer <ค่านี้> ให้อัตโนมัติตอนเรียก cron จริง
CRON_SECRET=ตั้งค่าอะไรก็ได้ที่สุ่มและยาว
